{
  // Проверка типов кода уроков (npm run validate). Настройки — как в tsconfig.json, который создаёт `ng new` в Angular 22
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["content/**/*.ts"],
  // Шаги с намеренно сломанным стартом (frontmatter `brokenStart: true`): ошибки в нём — часть урока.
  // Валидатор проверяет, что каждый такой шаг перечислен здесь
  "exclude": ["content/01-first-app/06-debugging/start/**"]
}
